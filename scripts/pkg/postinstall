#!/bin/bash
# Post-install script for NaturalScrollToggle.pkg
# Runs as root: fixes permissions/quarantine on the app and registers the
# LaunchAgent for the console user so the app starts at that user's login.
LOG=/tmp/nst-postinstall.log
exec >>"$LOG" 2>&1
set -x

APP="/Applications/NaturalScrollToggle.app"
BUNDLE_ID="com.wilde.naturalscrolltoggle"

# The payload should be in /Applications (preinstall removed other copies).
# If it was still relocated, find the freshest copy and move it back.
if [ ! -d "$APP" ]; then
    FOUND=$(mdfind "kMDItemCFBundleIdentifier == '$BUNDLE_ID'" 2>/dev/null | head -1)
    if [ -n "$FOUND" ] && [ -d "$FOUND" ]; then
        rm -rf "$APP"
        mv "$FOUND" "$APP"
        echo "Normalized app location: $FOUND -> $APP"
    fi
fi

if [ ! -d "$APP" ]; then
    echo "ERROR: $APP not found after payload install"
    exit 1
fi

BIN="$APP/Contents/MacOS/NaturalScrollToggle"
chmod +x "$BIN"
xattr -dr com.apple.quarantine "$APP" 2>/dev/null || true

CONSOLE_USER=$(stat -f%Su /dev/console)
CONSOLE_UID=$(id -u "$CONSOLE_USER" 2>/dev/null || echo "")
USER_HOME=$(eval echo "~$CONSOLE_USER" 2>/dev/null || echo "")

if [ -n "$CONSOLE_UID" ] && [ "$CONSOLE_UID" != "0" ] && [ -n "$USER_HOME" ] && [ -d "$USER_HOME" ]; then
    LAUNCH_AGENTS="$USER_HOME/Library/LaunchAgents"
    PLIST="$LAUNCH_AGENTS/com.wilde.naturalscrolltoggle.plist"
    mkdir -p "$LAUNCH_AGENTS"
    cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wilde.naturalscrolltoggle</string>
    <key>ProgramArguments</key>
    <array>
        <string>$BIN</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
</dict>
</plist>
EOF
    chown "$CONSOLE_USER" "$PLIST" 2>/dev/null || true
    launchctl asuser "$CONSOLE_UID" launchctl unload "$PLIST" 2>/dev/null || true
    launchctl asuser "$CONSOLE_UID" launchctl load -w "$PLIST" || true
else
    echo "WARNING: could not determine console user; LaunchAgent not registered"
fi

echo "postinstall done"
exit 0

