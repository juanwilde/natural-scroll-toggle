#!/bin/bash
# Pre-install for NaturalScrollToggle.pkg (runs as root).
# Stops a running instance and forgets previous install receipts. It does
# NOT delete existing copies: Installer may "relocate" the payload to where
# an older copy exists, and deleting it mid-install races with that. The
# postinstall moves the final bundle to /Applications instead.
LOG=/tmp/nst-preinstall.log
exec >>"$LOG" 2>&1
set -x

killall NaturalScrollToggle 2>/dev/null || true
pkgutil --forget com.wilde.naturalscrolltoggle.pkg 2>/dev/null || true

echo "preinstall done"
exit 0
